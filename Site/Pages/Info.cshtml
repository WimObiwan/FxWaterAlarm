@page
@using System.Globalization
@model Info

@{
    Layout = "Shared/_Layout";
}

<h2 class="h4">Server-side</h2>

<table style="display: block">
    <tr>
        <td><strong>RequestHost</strong></td><td>@Model.RequestHost</td>
    </tr>
    <tr>
        <td><strong>RequestScheme</strong></td><td>@Model.RequestScheme</td>
    </tr>
    <tr>
        <td><strong>RequestIsHttps</strong></td><td>@Model.RequestIsHttps</td>
    </tr>
    <tr>
        <td><strong>Server</strong></td><td>@Model.Server</td>
    </tr>
    <tr>
        <td><strong>Version</strong></td><td>@Model.Version</td>
    </tr>
    <tr>
        <td><strong>DeployDateTime</strong></td>
        <td>@(Model.DeployDateTime?.ToString("yyyy-MM-dd HH:mm:ss zzz") ?? "unknown")</td>
    </tr>
    <tr>
        <td><strong>DeployDateTimeSource</strong></td><td>@(Model.DeployDateTimeSource ?? "-")</td>
    </tr>
    <tr>
        <td><strong>OsVersion</strong></td><td>@Model.OsVersion</td>
    </tr>
    <tr>
        <td><strong>DotNetVersion</strong></td><td>@Model.DotNetVersion</td>
    </tr>
    <tr>
        <td><strong>ProcessStartTime</strong></td>
        <td>@(Model.ProcessStartTime?.ToString("yyyy-MM-dd HH:mm:ss zzz") ?? "unknown")</td>
    </tr>
    <tr>
        <td><strong>ConfiguredTokenLifespan</strong></td><td>@(Model.ConfiguredTokenLifespan ?? "-")</td>
    </tr>
    <tr>
        <td><strong>ConfiguredCookieExpireTimeSpan</strong></td><td>@(Model.ConfiguredCookieExpireTimeSpan ?? "-")</td>
    </tr>
    <tr>
        <td><strong>CookieSlidingExpiration</strong></td><td>@Model.CookieSlidingExpiration</td>
    </tr>
    <tr>
        <td><strong>IsAuthenticated</strong></td><td>@Model.IsAuthenticated</td>
    </tr>
    <tr>
        <td><strong>HasAuthCookie</strong></td><td>@Model.HasAuthCookie</td>
    </tr>
    <tr>
        <td><strong>AuthCookieLength</strong></td><td>@(Model.AuthCookieLength?.ToString() ?? "-")</td>
    </tr>
    <tr>
        <td><strong>AuthTicketStatus</strong></td><td>@(Model.AuthTicketStatus ?? "-")</td>
    </tr>
    <tr>
        <td><strong>AuthTicketFailure</strong></td><td>@(Model.AuthTicketFailure ?? "-")</td>
    </tr>
    <tr>
        <td><strong>UserEmail</strong></td><td>@(Model.UserEmail ?? "-")</td>
    </tr>
    <tr>
        <td><strong>ProviderSub</strong></td><td>@(Model.ProviderSub ?? "-")</td>
    </tr>
    <tr>
        <td><strong>LoginMethod</strong></td><td>@(Model.LoginMethod ?? "-")</td>
    </tr>
    <tr>
        <td><strong>LoginTimestamp</strong></td>
        <td>@(Model.LoginTimestamp?.ToString("yyyy-MM-dd HH:mm:ss zzz") ?? "unknown")</td>
    </tr>
    <tr>
        <td><strong>SessionExpiresAt</strong></td>
        <td>@(Model.SessionExpiresAt?.ToString("yyyy-MM-dd HH:mm:ss zzz") ?? "unknown")</td>
    </tr>
    <tr>
        <td><strong>SessionAge</strong></td><td>@(Model.SessionAge ?? "-")</td>
    </tr>
    <tr>
        <td><strong>SessionRemaining</strong></td><td>@(Model.SessionRemaining ?? "-")</td>
    </tr>
    <tr>
        <td><strong>IsAdmin</strong></td><td>@Model.IsAdmin</td>
    </tr>
    <tr>
        <td><strong>ClientIpAddress</strong></td><td>@(Model.ClientIpAddress ?? "-")</td>
    </tr>
    <tr>
        <td><strong>XForwardedFor</strong></td><td>@(Model.ClientForwardedFor ?? "-")</td>
    </tr>
    <tr>
        <td><strong>XForwardedProto</strong></td><td>@(Model.ClientForwardedProto ?? "-")</td>
    </tr>
    <tr>
        <td><strong>UserAgent</strong></td><td>@Model.UserAgent</td>
    </tr>
    <tr>
        <td><strong>ClaimTypes</strong></td><td>@Model.UserClaimsSummary</td>
    </tr>
    <tr>
        <td><strong>Culture</strong></td><td>@CultureInfo.CurrentCulture.Name</td>
    </tr>
    <tr>
        <td><strong>UICulture</strong></td><td>@CultureInfo.CurrentUICulture.Name</td>
    </tr>
    <tr>
        <td><strong>DateTime</strong></td><td>@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss zzz")</td>
    </tr>
    <tr>
        <td><strong>DateTimeUTC</strong></td><td>@DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC</td>
    </tr>
    <tr>
        <td><strong>Environment</strong></td><td>@Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT")</td>
    </tr>
    <tr>
        <td><strong>UseDevBranding</strong></td><td>@Model.UseDevBranding</td>
    </tr>
    <tr>
        <td><strong>AutoCookieLink</strong></td><td>@(Model.AutoCookieLink ?? "-")</td>
    </tr>
</table>

<h2 class="h4 mt-3 d-flex align-items-center gap-3">
    Connection
    <button type="button" id="infoClientRefresh" class="btn btn-link p-0" style="font-size: 1.5em" title="Refresh connection information">
        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
    </button>
    <span class="form-check form-switch fs-6 fw-normal mb-0">
        <input class="form-check-input" type="checkbox" role="switch" id="infoClientAutoRefresh" autocomplete="off">
        <label class="form-check-label" for="infoClientAutoRefresh">auto-refresh</label>
    </span>
</h2>

<table id="infoClient" style="display: block">
    <tr>
        <td><strong>BrowserOnLine</strong></td><td data-client="onLine">-</td>
    </tr>
    <tr>
        <td><strong>ServerReachable</strong></td><td data-client="reachable">-</td>
    </tr>
    <tr>
        <td><strong>ServerRoundTrip</strong></td><td data-client="roundTrip">-</td>
    </tr>
    <tr>
        <td><strong>LastProbe</strong></td><td data-client="lastProbe">-</td>
    </tr>
    <tr>
        <td><strong>ConnectionEffectiveType</strong></td><td data-client="effectiveType">-</td>
    </tr>
    <tr>
        <td><strong>ConnectionDownlink</strong></td><td data-client="downlink">-</td>
    </tr>
    <tr>
        <td><strong>ConnectionRtt</strong></td><td data-client="rtt">-</td>
    </tr>
    <tr>
        <td><strong>ConnectionSaveData</strong></td><td data-client="saveData">-</td>
    </tr>
    <tr>
        <td><strong>LastChange</strong></td><td data-client="lastChange">-</td>
    </tr>
</table>

<div class="d-none" aria-hidden="true">
    <textarea id="infoTroubleshootingCopy"
              class="form-control"
              rows="14"
              readonly>@Model.TroubleshootingInfo</textarea>
</div>

<div class="mt-2 mb-3">
    <button type="button"
            class="btn btn-outline-secondary"
            title="Copy this information"
            data-clipboard
            data-clipboard-target="#infoTroubleshootingCopy">
        <i class="bi bi-clipboard" aria-hidden="true"></i>
        Copy this information
    </button>
</div>

@section Scripts {
<script>
    (function () {
        const copy = document.getElementById('infoTroubleshootingCopy');
        const serverInfo = copy.value;
        const cells = {};
        document.querySelectorAll('#infoClient [data-client]').forEach(td => cells[td.dataset.client] = td);

        // navigator.connection (Network Information API) is Chromium-only; show "unsupported" elsewhere.
        const c = navigator.connection;
        const fmt = v => v === undefined || v === null ? (c ? '-' : 'unsupported') : String(v);

        // navigator.onLine only says whether the device has *a* network (LAN, Wi-Fi), not whether
        // it reaches the internet: false is reliable, true is not. So actually ask the server.
        // HEAD on a small static file, cache-busted; the service worker does not intercept fetches.
        const probeIntervalMs = 15000;
        const probeTimeoutMs = 5000;
        let probe = { reachable: 'probing…', roundTrip: '-', lastProbe: '-' };

        let probing = false;

        async function runProbe() {
            // Auto-refresh fires every second but a probe may take up to probeTimeoutMs: never overlap.
            if (probing) return;
            probing = true;
            const controller = new AbortController();
            const timer = setTimeout(() => controller.abort(), probeTimeoutMs);
            const started = performance.now();
            let reachable;
            try {
                const response = await fetch('/favicon.ico?probe=' + Date.now(),
                    { method: 'HEAD', cache: 'no-store', signal: controller.signal });
                reachable = response.ok ? 'yes' : 'no (HTTP ' + response.status + ')';
            } catch (e) {
                reachable = e.name === 'AbortError' ? 'no (timeout after ' + probeTimeoutMs + ' ms)' : 'no (network error)';
            } finally {
                clearTimeout(timer);
                probing = false;
            }
            const elapsed = Math.round(performance.now() - started);
            probe = {
                reachable: reachable,
                roundTrip: reachable === 'yes' ? elapsed + ' ms' : '-',
                lastProbe: new Date().toLocaleString()
            };
            update();
        }

        function update() {
            const values = {
                onLine: String(navigator.onLine),
                reachable: probe.reachable,
                roundTrip: probe.roundTrip,
                lastProbe: probe.lastProbe,
                effectiveType: fmt(c?.effectiveType),
                downlink: c?.downlink !== undefined ? c.downlink + ' Mbps' : fmt(undefined),
                rtt: c?.rtt !== undefined ? c.rtt + ' ms' : fmt(undefined),
                saveData: fmt(c?.saveData),
                lastChange: new Date().toLocaleString()
            };
            for (const [key, value] of Object.entries(values))
                cells[key].textContent = value;

            // Keep "Copy this information" complete: server text plus the current client values.
            copy.value = serverInfo + '\n'
                + 'BrowserOnLine: ' + values.onLine + '\n'
                + 'ServerReachable: ' + values.reachable + '\n'
                + 'ServerRoundTrip: ' + values.roundTrip + '\n'
                + 'ConnectionEffectiveType: ' + values.effectiveType + '\n'
                + 'ConnectionDownlink: ' + values.downlink + '\n'
                + 'ConnectionRtt: ' + values.rtt + '\n'
                + 'ConnectionSaveData: ' + values.saveData;
        }

        // A network change is exactly when reachability may have changed: re-probe right away.
        const onNetworkChange = () => { update(); runProbe(); };
        c?.addEventListener('change', onNetworkChange);
        window.addEventListener('online', onNetworkChange);
        window.addEventListener('offline', onNetworkChange);
        // Background tabs throttle timers; probe again as soon as the page is visible.
        document.addEventListener('visibilitychange', () => { if (!document.hidden) runProbe(); });
        setInterval(() => { if (!document.hidden) runProbe(); }, probeIntervalMs);
        document.getElementById('infoClientRefresh').addEventListener('click', onNetworkChange);

        // Auto-refresh: off after every page load (autocomplete="off" stops the browser restoring it).
        let autoRefreshTimer = null;
        const autoRefresh = document.getElementById('infoClientAutoRefresh');
        autoRefresh.checked = false;
        autoRefresh.addEventListener('change', () => {
            clearInterval(autoRefreshTimer);
            autoRefreshTimer = autoRefresh.checked
                ? setInterval(() => { if (!document.hidden) onNetworkChange(); }, 1000)
                : null;
            if (autoRefresh.checked) onNetworkChange();
        });

        update();
        runProbe();
    })();
</script>
}
