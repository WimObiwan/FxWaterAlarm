@page
@using Microsoft.AspNetCore.Mvc.Localization
@model Login
@inject IViewLocalizer Loc

@{
    ViewData["Title"] = Loc["Login"].Value;
    Layout = "Shared/_Layout";
}

<div class="row justify-content-center mt-4">
    <div class="col-sm-10 col-md-7 col-lg-5">

        <h2 class="mb-4">@Loc["Login"]</h2>

        @if (Model.Error != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@Loc["Error_" + Model.Error]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @* ── Single sign-on ───────────────────────────────── *@
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@Loc["Login with single sign-on"]</h5>
                @if (Model.OidcEnabled)
                {
                    <form method="get" action="/login">
                        <input type="hidden" name="handler" value="Oidc" />
                        @if (Model.ReturnUrl != null)
                        {
                            <input type="hidden" name="r" value="@Model.ReturnUrl" />
                        }
                        <button type="submit" class="btn btn-primary">
                            @Loc["Continue with single sign-on"]
                        </button>
                    </form>
                }
                else
                {
                    <p class="card-text text-muted small">
                        @Loc["Single sign-on is not yet available. It will be introduced in a future update."]
                    </p>
                    <button class="btn btn-primary" disabled title="@Loc["Coming soon"].Value">
                        @Loc["Continue with single sign-on"]
                    </button>
                }
            </div>
        </div>

        @* ── Email code ────────────────────────────────────── *@
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="bi bi-envelope me-2"></i>@Loc["Login with email code"]
                </h5>
                <p class="card-text text-muted small">
                    @Loc["Enter your e-mail address. We will send you a one-time code to verify your identity."]
                </p>
                <form method="post" action="/account/loginmessage">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="mode" value="21" />
                    @if (Model.ReturnUrl != null)
                    {
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    }
                    <div class="input-group">
                        <input type="email"
                               class="form-control"
                               name="emailAddress"
                               placeholder="@Loc["your@email.com"].Value"
                               autocomplete="email"
                               required />
                        <button type="submit" class="btn btn-outline-secondary">
                            @Loc["Send code"]
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>
