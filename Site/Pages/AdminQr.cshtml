@page
@using System.Text
@using Net.Codecrete.QrCodeGenerator
@model AdminQr

@{
    QrCode qrCode = QrCode.EncodeText(Model.QrUrl, QrCode.Ecc.Quartile);
    string svg = qrCode.ToSvgString(0, "black", "transparent");
    string img = "data:image/svg+xml;base64," + Convert.ToBase64String(Encoding.UTF8.GetBytes(svg));
}
<img alt="qrcode" src="@img" class="qr-code qr-code-sm" width="165" height="165"/>
